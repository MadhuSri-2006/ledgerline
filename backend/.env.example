# LedgerLine Backend — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# PostgreSQL connection string (Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: Dedicated test database connection string (prevents running tests against live/demo data)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/TEST_DBNAME?sslmode=require"

# JWT signing secret — use a random 32+ character string
JWT_SECRET="replace-with-at-least-32-random-characters"

# JWT token expiry (default: 24 hours)
JWT_EXPIRES_IN="24h"

# Allowed CORS origin for the frontend
CORS_ORIGIN="http://localhost:5173"

# Express server port
PORT=5000
