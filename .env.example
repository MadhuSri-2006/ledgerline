# LedgerLine Environment Configuration Template
# Copy this file to .env and replace placeholders with real configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/ledgerline?schema=public"

# Authentication (Cryptographically signed JWT)
# Minimum 32-character secret for HMAC-SHA256
JWT_SECRET="replace_with_a_long_random_secret_min_32_characters"
JWT_EXPIRES_IN="24h"

# Frontend Client Origin (for CORS)
CORS_ORIGIN="http://localhost:5173"
